  "repository": {
    "type": "git",
    "url": "git+https://github.com/89rat/langchain-code402.git"
  },
  "homepage": "https://hcrb.in",
  "dependencies": {
    "@code-402/agent-tools": "^0.2.1",
    "json-schema-to-zod": "^2.6.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "zod": ">=3.22.0"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.22.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
