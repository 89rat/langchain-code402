{
  "name": "@code-402/langchain",
  "version": "0.1.0",
  "description": "code402 x402 pay-per-call tools as LangChain DynamicStructuredTools — IBAN/LEI/VAT/GSTIN/IFSC/SWIFT/sanctions verification, non-custodial USDC-on-Base payments with a hard client-side spend cap.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
